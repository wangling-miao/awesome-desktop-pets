{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pet.nether.top/schemas/pet.schema.json",
  "title": "Desktop Pet Gallery manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "id",
    "name",
    "version",
    "author",
    "description",
    "tags",
    "license",
    "preview",
    "format",
    "resolution",
    "createdAt",
    "spritesheetPath"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,62}[a-z0-9]$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "displayName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?$"
    },
    "author": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 240
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
      }
    },
    "license": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80
    },
    "preview": {
      "type": "string",
      "const": "preview.gif"
    },
    "previewImage": {
      "type": "string",
      "const": "preview.png"
    },
    "previewWebp": {
      "type": "string",
      "const": "preview.webp"
    },
    "download": {
      "type": "string"
    },
    "format": {
      "type": "string",
      "enum": ["desktop-pet", "hatch-pet-compatible"]
    },
    "resolution": {
      "type": "string",
      "enum": ["1x", "2x", "4x"]
    },
    "createdAt": {
      "type": "string",
      "format": "date"
    },
    "homepage": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "spritesheetPath": {
      "type": "string",
      "minLength": 1
    },
    "spritesheets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "1x": { "type": "string" },
        "2x": { "type": "string" },
        "4x": { "type": "string" }
      }
    },
    "cellSize": {
      "type": "object",
      "required": ["width", "height"],
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "sourceScale": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "pixelated": {
      "type": "boolean"
    }
  }
}
